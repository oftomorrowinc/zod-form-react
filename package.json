{
  "name": "@oftomorrow/zod-form",
  "version": "1.0.1",
  "description": "Schema-driven React form renderer powered by Zod, with pluggable storage adapters (Firebase, BYO). Styled with shadcn/ui primitives.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./firebase": {
      "import": {
        "types": "./dist/firebase/index.d.ts",
        "default": "./dist/firebase/index.js"
      },
      "require": {
        "types": "./dist/firebase/index.d.cts",
        "default": "./dist/firebase/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/styles.css",
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css}\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "verify": "effective verify",
    "audit": "effective audit",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "react",
    "zod",
    "forms",
    "react-hook-form",
    "schema-driven",
    "typescript",
    "tailwind",
    "shadcn",
    "validation",
    "firebase",
    "firestore"
  ],
  "author": "Todd Sampson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oftomorrowinc/zod-form-react.git"
  },
  "bugs": {
    "url": "https://github.com/oftomorrowinc/zod-form-react/issues"
  },
  "homepage": "https://github.com/oftomorrowinc/zod-form-react#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "firebase": ">=10",
    "react": ">=18",
    "react-dom": ">=18",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "lucide-react": "^0.469.0",
    "react-hook-form": "^7.54.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@oftomorrow/effective": "0.1.0-rc.6",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase": "^11.8.0",
    "globals": "^17.0.0",
    "husky": "^9.1.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "tslib": "^2.8.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
